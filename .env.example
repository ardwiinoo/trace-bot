# Copy to .env and fill in. .env is gitignored.

# --- LLM: "gemini" or "claude" ---
LLM_PROVIDER=gemini

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Telegram ---
# Create a bot with @BotFather and paste the token.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot. Leave empty at first:
# message the bot once and it replies with your id, then put it here and restart.
TELEGRAM_ALLOWED_USER_IDS=

# --- Observability backends (docker compose overrides these for the bot container) ---
LOKI_URL=http://localhost:3100
PROMETHEUS_URL=http://localhost:9090
TIMEZONE=Asia/Jakarta

# --- Web API (used by the React UI) ---
HTTP_ADDR=:8081
WEB_ORIGIN=http://localhost:5173
# Optional bearer token required on /api/*. Leave empty for local dev.
WEB_API_TOKEN=
